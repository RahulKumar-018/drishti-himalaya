# Drishti-Himalaya Environmental & Routing API Configuration
# Public keyless APIs used for non-commercial prototype data collection
VITE_OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1
VITE_OPEN_METEO_ELEVATION_BASE_URL=https://api.open-meteo.com/v1
VITE_ENVIRONMENTAL_API_TIMEOUT_MS=8000

# Routing Engine Configuration (Phase 2)
# Free open-source routing machine cluster (default: OSRM public demo)
VITE_OSRM_BASE_URL=https://router.project-osrm.org
# Optional custom routing API key if routing via authenticated proxy/service
# VITE_ROUTING_API_KEY=

# MapTiler Basemap Configuration (Optional; MapTiler Topo-v4 basemap for Leaflet)
# If left unset, InteractiveMap gracefully falls back to OpenStreetMap
# Obtain a free key at https://cloud.maptiler.com/
VITE_MAPTILER_API_KEY=
