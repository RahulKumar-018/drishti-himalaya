# ==============================================================================
# DRISHTI-HIMALAYA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure the values for your local environment.
# NEVER commit .env to version control!
# ==============================================================================

# System Operating Mode: DEMO | LIVE
# DEMO: Uses local synthetic/deterministic datasets (guarantees zero-failure hackathon judging)
# LIVE: Connects to external APIs (Open-Meteo, OpenRouteService, PostGIS)
DATA_MODE=DEMO

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL/PostGIS for Production/Supabase; SQLite for Local Demo)
# Supabase Pooler URI: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Supabase Direct URI: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Local/Demo Fallback: sqlite:///./drishti_himalaya.db
DATABASE_URL=sqlite:///./drishti_himalaya.db
DATABASE_ENABLED=False

# Supabase API Credentials (Optional; for future REST/Storage interfaces)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# OpenRouteService API (Optional for LIVE mode routing; free tier at openrouteservice.org)
# Leave blank to use local deterministic NH-7 route geometry generator
OPENROUTESERVICE_API_KEY=

# MapTiler Basemap API Key (Optional; Topo-v4 basemap for Leaflet frontend)
# Obtain a free key at https://cloud.maptiler.com/
VITE_MAPTILER_API_KEY=

# Open-Meteo API (Open-access CC BY 4.0; no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Weather API Key (Optional; for future commercial provider or IMD data service)
WEATHER_API_KEY=

# Route Segmentation Configuration
SEGMENT_LENGTH_M=250
SPATIAL_SEGMENT_LENGTH_METERS=250

# Target Corridor Bounding Box (Uttarakhand)
LAT_MIN=28.7
LAT_MAX=31.5
LON_MIN=77.5
LON_MAX=81.1
MIN_LAT=28.7
MAX_LAT=31.5
MIN_LON=77.5
MAX_LON=81.1
