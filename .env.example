# ==============================================================================
# DRISHTI-HIMALAYA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure the values for your environment.
# NEVER commit production .env secrets to version control!
# ==============================================================================

# System Operating Mode: LIVE | DEMO
# LIVE: Connects to external APIs (Open-Meteo, OpenRouteService, PostgreSQL/PostGIS)
# DEMO: Offline deterministic baseline fixtures for isolated unit testing
DATA_MODE=LIVE

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL + PostGIS for Production / Supabase)
# Supabase Pooler URI: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Supabase Direct URI: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Local Demo Alternative: sqlite:///./drishti_himalaya.db
DATABASE_URL=postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres
DATABASE_ENABLED=True

# Supabase Credentials (Optional for client-side storage / auth integration)
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouteService API (Directions & Mountain Highway Geometry; get free key at https://openrouteservice.org)
OPENROUTESERVICE_API_KEY=

# Open-Meteo API (Open-access CC BY 4.0; real-time precipitation & forecast)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# MapTiler Basemap API Key (Optional; Topo-v4 basemap for Leaflet frontend)
VITE_MAPTILER_API_KEY=

# Firebase Cloud Messaging (FCM) Configuration (Optional; for mobile push alerts)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Route Segmentation Configuration (Phase 5: 250m intervals)
SEGMENT_LENGTH_M=250
SPATIAL_SEGMENT_LENGTH_METERS=250

# Target Corridor Bounding Box (Uttarakhand)
LAT_MIN=28.7
LAT_MAX=31.5
LON_MIN=77.5
LON_MAX=81.1
MIN_LAT=28.7
MAX_LAT=31.5
MIN_LON=77.5
MAX_LON=81.1
