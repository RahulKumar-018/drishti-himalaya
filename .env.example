# ==============================================================================
# DRISHTI-HIMALAYA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure the values for your local environment.
# NEVER commit .env to version control!
# ==============================================================================

# System Operating Mode: DEMO | LIVE
# DEMO: Uses local synthetic/deterministic datasets (guarantees zero-failure hackathon judging)
# LIVE: Connects to external APIs (Open-Meteo, OpenRouteService, PostGIS)
DATA_MODE=DEMO

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL/PostGIS for Production; SQLite for Local Demo)
# Production: postgresql://postgres:password@localhost:5432/drishti_himalaya
# Local/Demo Fallback: sqlite:///./drishti_himalaya.db
DATABASE_URL=sqlite:///./drishti_himalaya.db

# OpenRouteService API (Optional for LIVE mode routing; free tier at openrouteservice.org)
# Leave blank to use local deterministic NH-7 route geometry generator
OPENROUTESERVICE_API_KEY=

# Open-Meteo API (Open-access CC BY 4.0; no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Geospatial Cache Settings
WEATHER_CACHE_TTL_HOURS=3
SPATIAL_SEGMENT_LENGTH_METERS=250

# Target Corridor Bounding Box (Uttarakhand)
MIN_LAT=28.7
MAX_LAT=31.5
MIN_LON=77.5
MAX_LON=81.1
